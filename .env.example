# ==============================================================================
# StüdyoAsistan — Ortam Değişkenleri Şablonu
# Bu dosyayı ".env.local" olarak kopyalayıp kendi anahtarlarınızı girin.
# DİKKAT: ".env.local" dosyası .gitignore kapsamındadır ve asla Git'e gönderilmez.
# ==============================================================================

# --- Sunucu Taraflı Gemini AI Yapılandırması (ASLA VITE_ öneki eklemeyin) ---
# API uç noktaları (/api/ai/*) yalnızca sunucu tarafında çalışır; tarayıcıya sızmaz.
GEMINI_API_KEY=""

# Opsiyonel: Varsayılan modelin (gemini-4-hydrogen) üzerine yazmak isterseniz
# GEMINI_MODEL="gemini-4-hydrogen"

# Opsiyonel: Uygulamanın canlı URL adresi ve yerel geliştirme portu
APP_URL="http://localhost:3000"
PORT="3000"

# --- İstemci Taraflı Firebase Web Uygulaması Yapılandırması ---
# Firebase Console -> Project Settings -> Your apps (Web) bölümünden alın.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Opsiyonel: Varsayılan "(default)" dışında özel bir Firestore veritabanı kullanıyorsanız
VITE_FIREBASE_DATABASE_ID=""
